# --- Python ---
# Кэш байткода, который появляется после запуска скрипта и тестов
__pycache__/
*.py[cod]

# Виртуальные окружения (в репозиторий не нужны)
.venv/
venv/
env/

# Артефакты сборки/тестов
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# --- Системное ---
# Служебные файлы macOS и Windows
.DS_Store
Thumbs.db

# --- Локальные файлы ---
# Временные файлы и логи замеров
*.log
*.tmp
